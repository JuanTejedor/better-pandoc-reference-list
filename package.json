{
  "name": "better-pandoc-reference-list",
  "version": "3.0.1",
  "description": "A maintained fork of Obsidian Pandoc Reference List",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "check-types": "tsc --noemit",
    "lint": "eslint ./src",
    "prettier": "prettier --write \"./src/**/*.{ts,tsx}\"",
    "test": "jest",
    "rlnotes": "git log $(git describe --tags --abbrev=0)..HEAD --oneline > release-notes.md && git add release-notes.md",
    "bump": "node version-bump.mjs && git add package.json manifest.json versions.json && yarn rlnotes",
    "release": "git commit -m $npm_package_version && git tag $npm_package_version && git push && git push --tags"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0",
  "devDependencies": {
    "@babel/core": "7.17.9",
    "@babel/preset-env": "7.16.11",
    "@babel/preset-typescript": "7.16.7",
    "@codemirror/language": "^6.10.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.26.0",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/jest": "27.4.1",
    "@types/lru-cache": "7.6.1",
    "@types/node": "16.11.6",
    "@types/react-dom": "18.2.6",
    "@types/which": "2.0.1",
    "@typescript-eslint/eslint-plugin": "5.2.0",
    "@typescript-eslint/parser": "5.2.0",
    "babel-jest": "27.5.1",
    "cross-env": "7.0.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jest": "27.5.1",
    "obsidian": "^1.8.7",
    "tslib": "2.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "xml-js": "1.6.11"
  },
  "dependencies": {
    "@lezer/common": "^1.5.3",
    "citeproc": "2.4.63",
    "fast-deep-equal": "^3.1.3",
    "fuse.js": "6.6.2",
    "lru-cache": "7.8.1",
    "preact": "^10.16.0",
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat",
    "react-select": "5.7.3",
    "text-clipper": "^2.2.0",
    "which": "2.0.2"
  },
  "jest": {
    "transformIgnorePatterns": [],
    "testEnvironment": "jsdom"
  }
}
